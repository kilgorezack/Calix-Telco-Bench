# Copy to .env; it is intentionally ignored by Git.
# Local artifact bundle for config.yaml. This path is deployment-specific and
# intentionally not committed in the portable evaluation configuration.
CALIX_TELCO_BENCH_RELEASE_ROOT=/path/to/Release_1.0

#
# These judge identifiers are recorded in score provenance. Use an immutable
# provider revision when the provider offers one; otherwise leave the revision
# blank and the report will correctly record a mutable-alias limitation.
CALIX_TELCO_BENCH_JUDGE_PROVIDER=anthropic
CALIX_TELCO_BENCH_JUDGE_MODEL=claude-sonnet-4-5
CALIX_TELCO_BENCH_JUDGE_MODEL_REVISION=

# Provider credentials are consumed only by an external judge-generation tool,
# never by config.yaml or the read-only TUI. Uncomment exactly one credential.
#
# For the public Anthropic API (default):
#   - Leave ANTHROPIC_BASE_URL unset or commented out
#   - Set ANTHROPIC_API_KEY to your API key
#
# For a custom Anthropic-compatible endpoint:
#   - Set ANTHROPIC_BASE_URL to your endpoint (e.g., https://api.yourcompany.com/)
#   - Set ANTHROPIC_AUTH_TOKEN to your authentication token
#   - If the endpoint uses a private certificate authority, set
#     CALIX_TELCO_BENCH_JUDGE_CA_BUNDLE to that CA's PEM file. TLS certificate
#     verification is always on; it is never disabled.
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.example.com/
# ANTHROPIC_AUTH_TOKEN=
# CALIX_TELCO_BENCH_JUDGE_CA_BUNDLE=/path/to/private-ca.pem

# Optional tokens for OpenAI-compatible generation endpoints. A config names
# the variable it reads through provider.api_key_env or a target's api_key_env.
# GPT_OSS_AUTH_TOKEN=
# ORNITH_AUTH_TOKEN=
# GEMINI_AUTH_TOKEN=
# GEMMA_AUTH_TOKEN=
